Use importlib.util.cache_from_source instead of the removed imp module.

The py-compile script shipped with xcb-proto 1.10 imports the `imp` module,
which was removed in Python 3.12, so installing the xcbgen Python module
fails under a modern system Python.

Keep the original fallback (compile next to the source) for interpreters
without importlib.util.cache_from_source.

--- a/py-compile
+++ b/py-compile
@@ -116,7 +116,11 @@
 fi

 $PYTHON -c "
-import sys, os, py_compile, imp
+import sys, os, py_compile
+try:
+    from importlib.util import cache_from_source
+except ImportError:
+    cache_from_source = None

 files = '''$files'''

@@ -129,15 +133,19 @@
 	    continue
     sys.stdout.write(file)
     sys.stdout.flush()
-    if hasattr(imp, 'get_tag'):
-        py_compile.compile(filepath, imp.cache_from_source(filepath), path)
+    if cache_from_source is not None:
+        py_compile.compile(filepath, cache_from_source(filepath), path)
     else:
         py_compile.compile(filepath, filepath + 'c', path)
 sys.stdout.write('\n')" || exit $?

 # this will fail for python < 1.5, but that doesn't matter ...
 $PYTHON -O -c "
-import sys, os, py_compile, imp
+import sys, os, py_compile
+try:
+    from importlib.util import cache_from_source
+except ImportError:
+    cache_from_source = None

 # pypy does not use .pyo optimization
 if hasattr(sys, 'pypy_translation_info'):
@@ -153,8 +161,8 @@
 	    continue
     sys.stdout.write(file)
     sys.stdout.flush()
-    if hasattr(imp, 'get_tag'):
-        py_compile.compile(filepath, imp.cache_from_source(filepath, False), path)
+    if cache_from_source is not None:
+        py_compile.compile(filepath, cache_from_source(filepath, False), path)
     else:
         py_compile.compile(filepath, filepath + 'o', path)
 sys.stdout.write('\n')" 2>/dev/null || :
